# DataGuard Québec — local development only
DATAGUARD_ENVIRONMENT=development
DATAGUARD_DATABASE_URL=postgresql+psycopg://dataguard:dataguard@localhost:5432/dataguard
DATAGUARD_ALLOWED_ORIGINS=["http://localhost:3000"]
DATAGUARD_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
DATAGUARD_JWT_SECRET=replace-with-at-least-32-random-characters
DATAGUARD_JWT_ALGORITHM=HS256
DATAGUARD_REDIS_URL=redis://localhost:6379/0
DATAGUARD_DOCUMENT_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
DATAGUARD_RAW_DOCUMENT_RETENTION_DAYS=7

# Docker Compose local stack
POSTGRES_DB=dataguard
POSTGRES_USER=dataguard
POSTGRES_PASSWORD=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:8000
DATAGUARD_PORT=8000

# Production: configure an approved OIDC provider and asymmetric local session signing.
# DATAGUARD_ENVIRONMENT=production
# DATAGUARD_DATABASE_URL=postgresql+psycopg://<secret>@<private-db-host>:5432/dataguard
# DATAGUARD_JWT_ALGORITHM=RS256
# DATAGUARD_JWT_SIGNING_KEY=<PEM private key from secret manager>
# DATAGUARD_JWT_VERIFICATION_KEY=<PEM public key>
# DATAGUARD_OIDC_ISSUER_URL=https://identity.example.gov
# DATAGUARD_OIDC_JWKS_URL=https://identity.example.gov/.well-known/jwks.json
# DATAGUARD_JWT_ISSUER=https://dataguard.example.gov
# DATAGUARD_JWT_AUDIENCE=dataguard-api
# DATAGUARD_DOCUMENT_ENCRYPTION_KEY=<url-safe-base64-32-byte-key-from-secret-manager>
# DATAGUARD_CLAMAV_URL=tcp://clamav.internal:3310
# DATAGUARD_ALLOWED_ORIGINS=["https://dataguard.example.gov"]
